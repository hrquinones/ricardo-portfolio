# Canonical production URL used for metadata, canonical links, the sitemap,
# robots.txt, and JSON-LD. Domain is TBD (see docs/06-deployment-spec.md) —
# set this once the production domain is registered and configured on Vercel.
# Falls back to the Vercel deployment URL in preview builds, and to
# http://localhost:3000 in local development.
SITE_URL=https://example.com
